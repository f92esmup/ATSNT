[Unit]
Description=ATSNT Algorithmic Trading Engine (Paper / Live)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=f92esmup
WorkingDirectory=/home/f92esmup/Projects/ATSNT

# Observability Configuration
# Limit logs to INFO level so hot-path tick telemetry (TRACE) does not incur disk/CPU overhead
Environment="RUST_LOG=info,adapters=info"

# Binary Execution
# By default runs in paper trading mode with Telegram alerts and BigQuery streaming enabled.
# Add --show-ticks only during interactive terminal sessions when debugging.
ExecStart=/home/f92esmup/Projects/ATSNT/target/release/paper_trading --symbol btcusdt --telegram-alerts --gcp-bigquery

# Resilience & Auto-Restart Policies
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s

# Sandboxing & Resource Limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
