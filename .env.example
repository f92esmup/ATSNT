# Settings for ATSNT. Copy this file to .env and fill it in:
#   cp .env.example .env
#   chmod 600 .env
#   set -a; source .env; set +a
#
# - Never commit .env: it is ignored by .gitignore.
# - The Kraken keys will be read by the Kraken adapter (WP-13). Create a spot key with query,
#   order and WebSocket permissions and WITHOUT withdrawal rights.

# Telegram alerts (read by TelegramNotifier::from_env). Leave them empty to run without alerts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Binance keys: read only by the legacy live_trading and paper_trading binaries, until WP-14 and
# WP-15 replace them. Leave them empty: nothing in the Kraken plan uses them.
BINANCE_API_KEY="your_binance_api_key_here"
BINANCE_SECRET_KEY="your_binance_secret_key_here"
