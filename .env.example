# Binance API Credentials Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#   source .env
#
# IMPORTANT:
# - Never commit .env to version control (it is ignored by .gitignore).
# - For production VPS deployments, restrict API keys by IP and disable withdrawal permissions.

# Binance API Key (32/64 character alphanumeric string)
BINANCE_API_KEY="your_binance_api_key_here"

# Binance Secret Key (used locally to sign HMAC-SHA256 request payloads)
BINANCE_SECRET_KEY="your_binance_secret_key_here"
